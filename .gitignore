node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Environment — never commit real secrets
.env
.env.local
.env.*.local
# Backups of an env file are still an env file.
.env*.bak
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Generated
apps/api/src/generated/
apps/api/prisma/generated/
# Uploaded files (STORAGE_LOCAL_ROOT). Anchored with a leading slash: a bare
# "storage/" also matched apps/api/src/modules/storage/, which silently kept six
# source files out of the repo until a clean Docker build failed to compile.
/storage/
/apps/api/storage/
.tmp/

# Production secrets — never committed.
.secrets.production.local

.vercel

# The brochure masters, edited here and copied into apps/web/public/brochures/
# when they are ready to publish. Anchored with a leading slash so it matches
# only this folder at the root, never the served copy.
#
# Ignored because the published copies are already in the repository — 73MB of
# them — and a `git add -A` from the root would commit the same files a second
# time. That is 73MB more in the history and no way to take it back out without
# rewriting it.
/Brochures/
