node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Environment — never commit real secrets
.env
.env.local
.env.*.local
# Backups of an env file are still an env file.
.env*.bak
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Generated
apps/api/src/generated/
apps/api/prisma/generated/
# Uploaded files (STORAGE_LOCAL_ROOT). Anchored with a leading slash: a bare
# "storage/" also matched apps/api/src/modules/storage/, which silently kept six
# source files out of the repo until a clean Docker build failed to compile.
/storage/
/apps/api/storage/
.tmp/

# Production secrets — never committed.
.secrets.production.local

.vercel
