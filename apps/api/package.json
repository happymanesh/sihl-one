{
  "name": "@sihl-one/api",
  "version": "0.1.0",
  "private": true,
  "description": "SIHL ONE API — NestJS 11 system-of-engagement service.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/unit/scope.test.ts test/unit/audit.test.ts test/unit/storage.test.ts test/unit/clamav.test.ts test/unit/geocoding.test.ts test/unit/speech.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.e2e-test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "bootstrap:team": "tsx prisma/bootstrap-team.ts",
    "clean:test-data": "tsx prisma/clean-test-data.ts",
    "seed:products": "tsx prisma/seed-product-content.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sihl-one/contracts": "*",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "otpauth": "^9.5.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
