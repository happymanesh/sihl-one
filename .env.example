# ---------------------------------------------------------------------------
# SIHL ONE — root environment template.
# Copy to `.env` for local development. Never commit the populated file.
# In non-local environments every value below MUST come from the secrets
# manager (Azure Key Vault / AWS Secrets Manager), not from a file on disk.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sihl_one?schema=public"

# --- API -------------------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api
# Comma-separated list of origins permitted to call the API with credentials.
CORS_ORIGINS="http://localhost:3000"

# --- Authentication --------------------------------------------------------
# ADR-0004: local JWT issuance now, Synapse OIDC later. IDENTITY_PROVIDER
# selects the strategy; `local` is the only one wired in Phase 1.
IDENTITY_PROVIDER=local
JWT_ISSUER=https://one.sihl.in
JWT_AUDIENCE=sihl-one
# 64-char hex minimum. Generate: openssl rand -hex 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789abcdef0123456789abcdef"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-fedcba9876543210fedcba9876543210"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Argon2id tuning. Lower values are acceptable in dev only.
PASSWORD_PEPPER="dev-only-pepper-change-me"

# Account lockout policy
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="SIHL ONE"

# --- Optional infrastructure (Phase 2+) -----------------------------------
# REDIS_URL="redis://localhost:6379"
# S3_ENDPOINT=
# S3_BUCKET=
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
